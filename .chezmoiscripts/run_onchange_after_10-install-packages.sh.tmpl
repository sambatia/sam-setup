#!/usr/bin/env bash
#
# run_onchange_after — install the Brewfile. The Brewfile is embedded below via
# chezmoi's `include`, so this script's CONTENT changes whenever the Brewfile
# changes — which is exactly when chezmoi re-runs a run_onchange_ script. That's
# the fix for the "run_onchange + sentinel" trap: no separate sentinel needed,
# and a Brewfile edit reliably triggers a fresh `brew bundle`.
#
# Brewfile sha256: {{ include "Brewfile" | sha256sum }}
#
set -eu

command -v brew >/dev/null 2>&1 || { echo "brew missing — skipping bundle"; exit 0; }
eval "$(brew shellenv)" 2>/dev/null || true

{{- $profile := "full" -}}
{{- if hasKey . "profile" -}}{{- $profile = .profile -}}{{- end -}}
echo "Installing packages from the Brewfile (profile: {{ $profile }})…"
if [ "{{ $profile }}" = "core" ]; then
  echo "Core profile active: installing terminal, editor, and runtime tools (skipping heavy cloud/k8s casks)…"
  grep -vE '("argocd"|"k9s"|"kubeconform"|"kubectx"|"stern"|"cosign"|"crane"|"dagger/tap/dagger"|"opentofu"|"awscli"|"aquasecurity/trivy/trivy"|"orbstack"|"tableplus")' <<'BREWFILE' | brew bundle --no-lock --file=/dev/stdin
{{ include "Brewfile" }}
BREWFILE
else
  brew bundle --no-lock --file=/dev/stdin <<'BREWFILE'
{{ include "Brewfile" }}
BREWFILE
fi
echo "✓ packages installed."
