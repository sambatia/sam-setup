#!/usr/bin/env bash
#
# sam-setup-help — interactive cheatsheet and quick-reference guide.
#
# Usage:
#   sam-setup-help
#

set -u

if [ -t 1 ]; then
  C_B=$'\033[1m'
  C_G=$'\033[32m'
  C_Y=$'\033[33m'
  C_C=$'\033[36m'
  C_M=$'\033[35m'
  C_D=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_B=""; C_G=""; C_Y=""; C_C=""; C_M=""; C_D=""; C_RST=""
fi

cat <<EOF

${C_B}⚡ SAM-SETUP TERMINAL CHEATSHEET & QUICK REFERENCE${C_RST}
${C_D}Everything you need to master your new terminal environment.${C_RST}

${C_M}━━━ 1. TERMINAL & MULTIPLEXING ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}Tmux Prefix:${C_RST}       ${C_B}Ctrl + a${C_RST} (sensible prefix)
  ${C_C}Splits:${C_RST}            ${C_B}prefix + |${C_RST} (vertical)  ·  ${C_B}prefix + -${C_RST} (horizontal)
  ${C_C}Seamless Nav:${C_RST}      ${C_B}Ctrl + h / j / k / l${C_RST} (smart-splits across Tmux, Neovim, & Herdr)
  ${C_C}Mouse Toggle:${C_RST}      ${C_B}prefix + m${C_RST} (toggle mouse selection/scrolling)
  ${C_C}Session Restore:${C_RST}   ${C_B}prefix + Ctrl-s${C_RST} (save session)  ·  ${C_B}prefix + Ctrl-r${C_RST} (restore session)
  ${C_C}Ghostty Terminal:${C_RST}  ${C_B}Cmd + t${C_RST} (new native tab)  ·  ${C_B}Cmd + d${C_RST} (split right)  ·  ${C_B}Cmd + Shift + d${C_RST} (split down)
  ${C_C}Herdr Multiplexer:${C_RST} ${C_B}herdr${C_RST} (agentic orchestrator with topic sync)

${C_M}━━━ 2. MODERN CLI REPLACEMENTS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}eza${C_RST} (modern ls):     ${C_B}l${C_RST} (list)  ·  ${C_B}ll${C_RST} (details)  ·  ${C_B}lt${C_RST} (tree view)
  ${C_C}bat${C_RST} (modern cat):    ${C_B}bat <file>${C_RST} (syntax highlighted + line numbers)
  ${C_C}ripgrep${C_RST} (fast grep):  ${C_B}rg "<pattern>"${C_RST} (blazingly fast recursive search)
  ${C_C}fd${C_RST} (modern find):    ${C_B}fd <filename>${C_RST} (instant file finder)
  ${C_C}zoxide${C_RST} (smart cd):   ${C_B}z <dirname>${C_RST} (jump to frequently visited directory)
  ${C_C}atuin${C_RST} (shell history): ${C_B}Ctrl + r${C_RST} or ${C_B}Up Arrow${C_RST} (rich fuzzy history search)
  ${C_C}fzf${C_RST} (fuzzy finder):   ${C_B}Ctrl + t${C_RST} (files)  ·  ${C_B}Alt + c${C_RST} (directory cd)

${C_M}━━━ 3. POWER TUIS & TOOLS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}Git:${C_RST}               ${C_B}lg${C_RST} (lazygit)  ·  ${C_B}gh dash${C_RST} (GitHub PR/Issue dashboard)
  ${C_C}Docker:${C_RST}            ${C_B}ld${C_RST} (lazygit for containers)  ·  ${C_B}dive <image>${C_RST} (explore image layers)
  ${C_C}Files:${C_RST}             ${C_B}y${C_RST} / ${C_B}yazi${C_RST} (blazing async file manager with 12 plugins & kitty graphics)
                     ${C_B}spf${C_RST} (superfile: modern dual-pane TUI file manager)
  ${C_C}Workspace Hub:${C_RST}     ${C_B}tuios${C_RST} (terminal workspace & dashboard hub)
  ${C_C}System Monitor:${C_RST}    ${C_B}btop${C_RST} (Catppuccin Mocha TUI: CPU/RAM/disks/network/processes)
  ${C_C}Data & APIs:${C_RST}       ${C_B}vd <file>${C_RST} (visidata tabular wrangler)  ·  ${C_B}jqp${C_RST} (jq playground)
                     ${C_B}posting${C_RST} (TUI REST client)  ·  ${C_B}lazysql${C_RST} (database client)  ·  ${C_B}xh${C_RST} / ${C_B}hurl${C_RST}
  ${C_C}Disk & Cache:${C_RST}      ${C_B}kondo -n${C_RST} (dry-run clean stale build artifacts)  ·  ${C_B}dust${C_RST} (graphical du)
  ${C_C}Network:${C_RST}           ${C_B}trip <host>${C_RST} (Trippy interactive traceroute & ping)  ·  ${C_B}doggo${C_RST} (DNS client)

${C_M}━━━ 4. AI CODING AGENTS & LLM PIPELINES ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}Claude Code:${C_RST}       ${C_B}claude${C_RST} (Anthropic's official agentic engineering CLI)
  ${C_C}OpenAI Codex:${C_RST}      ${C_B}codex${C_RST} (terminal coding agent with gpt-6-astra & plan mode)
  ${C_C}Antigravity CLI:${C_RST}   ${C_B}agy${C_RST} (Google Gemini 3 agentic CLI with deep lifecycle hooks)
  ${C_C}CLI LLM Filter:${C_RST}    ${C_B}cat error.log | llm "explain this failure"${C_RST} (pipes to local/cloud models)
  ${C_C}Agent Multiplexer:${C_RST} ${C_B}herdr${C_RST} (syncs agent sessions, topics, & Neovim navigation)

${C_M}━━━ 5. NEOVIM / LAZYVIM ESSENTIALS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}Explorer:${C_RST}          ${C_B}<Space> e${C_RST} (Snacks file explorer)  ·  ${C_B}- ${C_RST} (Oil buffer filesystem)
  ${C_C}Fuzzy Search:${C_RST}      ${C_B}<Space> ff${C_RST} (find files)  ·  ${C_B}<Space> sg${C_RST} (live ripgrep grep)
  ${C_C}Diagnostics:${C_RST}       ${C_B}<Space> xx${C_RST} (Trouble diagnostics)  ·  ${C_B}[d / ]d${C_RST} (prev/next error)
  ${C_C}AI In-Editor:${C_RST}      ${C_B}Ctrl + \\${C_RST} (CodeCompanion chat)  ·  ${C_B}<Space> a${C_RST} (AI actions)
  ${C_C}Code Navigation:${C_RST}   ${C_B}s${C_RST} (Flash 2-char jump)  ·  ${C_B}K${C_RST} (LSP hover)  ·  ${C_B}gd${C_RST} (goto definition)
  ${C_C}Git In-Editor:${C_RST}     ${C_B}<Space> gg${C_RST} (lazygit)  ·  ${C_B}[h / ]h${C_RST} (prev/next git hunk)

${C_M}━━━ 6. LOCAL CUSTOMIZATION & UPDATES ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}
  ${C_C}Custom Aliases:${C_RST}    Put personal aliases/env vars in: ${C_Y}~/.zshrc.local${C_RST}
  ${C_C}Ghostty Tweaks:${C_RST}    Put custom font/dimension overrides in: ${C_Y}~/.config/ghostty/config.local${C_RST}
  ${C_C}Update Everything:${C_RST} Run ${C_G}update-all${C_RST} (coordinates Homebrew, mise, uv, Neovim, & dotfiles)
  ${C_C}Verify Health:${C_RST}     Run ${C_G}sam-setup-check${C_RST} (53-point automated health check)
  ${C_C}Rollback Changes:${C_RST}  Run ${C_G}sam-setup-restore${C_RST} (reverts dotfiles to pre-install backups)

EOF
