#!/usr/bin/env bash
#
# sam-setup-check — workstation replication health verification & self-healing doctor.
#
# Verifies that packages, runtimes, shell configurations, multiplexers,
# and fonts have been installed cleanly and correctly. Supports --fix
# to automatically remediate missing plugins or shims.
#
# Usage:
#   sam-setup-check
#   sam-setup-check --fix
#   sam-setup-check --help
#

set -u

FIX_MODE=0
for arg in "$@"; do
  case "$arg" in
    --fix|-f) FIX_MODE=1 ;;
    -h|--help)
      cat <<'EOF'
sam-setup-check — workstation replication health verification & self-healing doctor.

Usage:
  sam-setup-check          Run read-only health checks
  sam-setup-check --fix    Attempt automated safe fixes for missing plugins or shims
  sam-setup-check --help   Show this help
EOF
      exit 0
      ;;
  esac
done

if [ -t 1 ]; then
  C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_B=$'\033[1m'; C_C=$'\033[36m'; C_RST=$'\033[0m'
else
  C_G=""; C_Y=""; C_R=""; C_B=""; C_C=""; C_RST=""
fi

PASS=0
WARN=0
FAIL=0
FIXES=0

pass()  { PASS=$((PASS + 1)); printf '  %s✓%s %s\n' "$C_G" "$C_RST" "$1"; }
warn()  { WARN=$((WARN + 1)); printf '  %s!%s %s\n' "$C_Y" "$C_RST" "$1"; }
fail()  { FAIL=$((FAIL + 1)); printf '  %s✗%s %s\n' "$C_R" "$C_RST" "$1"; }
fixed() { FIXES=$((FIXES + 1)); printf '  %s🔧 Fixed:%s %s\n' "$C_C" "$C_RST" "$1"; }

printf '\n%s🔍 Workstation Health Check (sam-setup)%s\n\n' "$C_B" "$C_RST"

# 1. System Baseline
if [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
  pass "macOS system ($(sw_vers -productVersion 2>/dev/null || echo 'unknown'))"
else
  fail "Expected macOS"
fi

if [ "$(uname -m 2>/dev/null)" = "arm64" ]; then
  pass "Apple Silicon (arm64)"
else
  warn "Non-arm64 architecture ($(uname -m 2>/dev/null))"
fi

# 2. Package Managers
for pm in brew mise uv; do
  if command -v "$pm" >/dev/null 2>&1; then
    pass "Package manager: $pm is available"
  else
    fail "Package manager: $pm is missing"
  fi
done

# 3. Core Shell & Modern Utilities
REQUIRED_TOOLS="zsh git tmux herdr nvim starship zoxide atuin eza bat rg fd fzf lazygit btop yazi spf tuios just gh llm jqp vd lazysql mitmproxy kondo sam-setup-help sam-setup-doctor sam-setup-update"
for tool in $REQUIRED_TOOLS; do
  if command -v "$tool" >/dev/null 2>&1; then
    pass "CLI utility: $tool is ready"
  else
    fail "CLI utility: $tool is missing"
  fi
done

# 3b. AI Coding Agent Ecosystem
if command -v claude >/dev/null 2>&1; then
  pass "AI Agent: Claude Code CLI is ready ($(claude --version 2>/dev/null | head -1 || echo 'installed'))"
else
  warn "AI Agent: Claude Code CLI is missing (install via: brew install --cask claude-code@latest)"
fi

if command -v codex >/dev/null 2>&1; then
  pass "AI Agent: OpenAI Codex CLI is ready"
else
  warn "AI Agent: Codex CLI is missing (install via: mise use -g npm:@openai/codex)"
fi

if command -v agy >/dev/null 2>&1; then
  pass "AI Agent: Antigravity CLI (agy) is ready ($(agy --version 2>/dev/null || echo 'installed'))"
else
  warn "AI Agent: agy is not on PATH (managed via Antigravity IDE or ~/.local/bin/agy)"
fi

# 3c. Terminal TUIs & File Managers
if command -v spf >/dev/null 2>&1; then
  pass "TUI File Manager: Superfile (spf) is ready"
else
  fail "TUI File Manager: Superfile (spf) is missing"
fi

if command -v tuios >/dev/null 2>&1; then
  pass "TUI Workspace Hub: TUIOS is ready"
else
  fail "TUI Workspace Hub: TUIOS is missing"
fi

if command -v btop >/dev/null 2>&1; then
  pass "TUI System Monitor: btop is ready"
else
  fail "TUI System Monitor: btop is missing"
fi

if [ -d "$HOME/.config/yazi/plugins" ] && [ "$(ls -A "$HOME/.config/yazi/plugins" 2>/dev/null)" ]; then
  pass "Yazi plugins installed ($(ls "$HOME/.config/yazi/plugins" | wc -l | tr -d ' ') plugins active)"
else
  warn "Yazi plugins missing in ~/.config/yazi/plugins (run: ya pkg install)"
fi

# 3d. Neovim / LazyVim Ecosystem
if [ -d "$HOME/.config/nvim/lua/plugins" ]; then
  pass "LazyVim custom plugins configured ($(ls "$HOME/.config/nvim/lua/plugins" | wc -l | tr -d ' ') plugin specs present)"
else
  warn "LazyVim plugin specifications missing at ~/.config/nvim/lua/plugins"
fi

# 4. Runtimes & Languages
if command -v node >/dev/null 2>&1; then
  pass "Node.js runtime: $(node --version 2>/dev/null)"
else
  fail "Node.js is missing"
fi

if command -v pnpm >/dev/null 2>&1; then
  pass "pnpm package manager: $(pnpm --version 2>/dev/null)"
else
  if [ "$FIX_MODE" -eq 1 ] && command -v mise >/dev/null 2>&1; then
    mise use -g pnpm@latest >/dev/null 2>&1 && fixed "Installed pnpm via mise" || warn "pnpm installation failed"
  else
    warn "pnpm is missing (install via: mise use -g pnpm)"
  fi
fi

if command -v python3 >/dev/null 2>&1; then
  pass "Python runtime: $(python3 --version 2>/dev/null)"
else
  fail "Python 3 is missing"
fi

# 5. Terminal Application & Fonts
if [ -d "/Applications/Ghostty.app" ]; then
  pass "Ghostty terminal application is installed"
else
  warn "Ghostty.app not found in /Applications (manual download: ghostty.org)"
fi

if fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd Font" || [ -d "$HOME/Library/Fonts" ]; then
  pass "Nerd Fonts available"
else
  warn "JetBrains Mono Nerd Font may need terminal restart to be recognized"
fi

# 6. Shell Configuration Syntax
for rc in "$HOME/.zshrc" "$HOME/.zshenv" "$HOME/.zprofile"; do
  if [ -f "$rc" ]; then
    if zsh -n "$rc" >/dev/null 2>&1; then
      pass "$(basename "$rc") syntax is clean"
    else
      fail "$(basename "$rc") syntax has errors"
    fi
  else
    warn "$(basename "$rc") not found"
  fi
done

# 7. Git Identity
if git config --global user.name >/dev/null 2>&1 && git config --global user.email >/dev/null 2>&1; then
  pass "Git identity configured ($(git config --global user.name) <$(git config --global user.email)>)"
else
  warn "Git identity is not set. Run: git config --global user.name 'Your Name' && git config --global user.email 'you@example.com'"
fi

# 8. Multiplexers & Plugins
if [ -d "$HOME/.tmux/plugins/tpm" ]; then
  pass "Tmux Plugin Manager (TPM) is installed"
else
  if [ "$FIX_MODE" -eq 1 ]; then
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" >/dev/null 2>&1 \
      && [ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ] \
      && "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null 2>&1 \
      && fixed "Cloned TPM and installed Tmux plugins" || warn "TPM auto-fix failed"
  else
    warn "TPM directory missing at ~/.tmux/plugins/tpm (run: sam-setup-check --fix)"
  fi
fi

if [ -f "$HOME/.config/herdr/config.toml" ]; then
  pass "Herdr multi-agent multiplexer configuration is present"
  if [ "$FIX_MODE" -eq 1 ] && command -v herdr >/dev/null 2>&1; then
    for integ in claude codex omp cursor opencode; do
      herdr integration install "$integ" >/dev/null 2>&1 || true
    done
    fixed "Refreshed Herdr integrations"
  fi
else
  warn "Herdr config missing at ~/.config/herdr/config.toml"
fi

# 9. Shims self-healing
if [ "$FIX_MODE" -eq 1 ] && command -v mise >/dev/null 2>&1; then
  mise reshim >/dev/null 2>&1 && fixed "Mise shims reshimmed cleanly"
fi

if [ "$FIXES" -gt 0 ]; then
  printf '\n%s✨ Applied %d automatic fix(es).%s\n' "$C_C" "$FIXES" "$C_RST"
fi

printf '\n%sSummary: %s%d PASS%s · %s%d WARN%s · %s%d FAIL%s\n\n' \
  "$C_B" "$C_G" "$PASS" "$C_RST" "$C_Y" "$WARN" "$C_RST" "$C_R" "$FAIL" "$C_RST"

[ "$FAIL" -eq 0 ]
