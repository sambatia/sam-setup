# Terminal tools selected by the 2026-07-23 workstation audit.
# This manifest intentionally excludes packages already owned elsewhere.

tap "terraform-linters/tap"

# Homebrew requires explicit trust for this official third-party cask.
cask "terraform-linters/tap/tflint"

brew "actionlint"
brew "dive"
brew "fx"
brew "git-absorb"
brew "hurl"
brew "iperf3"
brew "kubeconform"
brew "lychee"
brew "ov"
brew "qsv"
brew "rich-cli"
brew "trippy"
brew "typos-cli"
brew "worktrunk"

# Official Ookla CLI; Python speedtest-cli is a different product.
tap "teamookla/speedtest"
brew "teamookla/speedtest/speedtest"

# tmux parallel-agent stack (2026-09-12); update-all owns upgrades.
tap "yoanwai/tap"
tap "raine/workmux"
cask "yoanwai/tap/agent-manager"
brew "raine/workmux/workmux"
